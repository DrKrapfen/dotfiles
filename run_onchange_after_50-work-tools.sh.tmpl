{{ if .isWork -}}
#!/usr/bin/env bash
# Work-only tooling: ansible (one full install via uv) + usage-push cron.
set -euo pipefail
MISE="$(command -v mise || echo "$HOME/.local/bin/mise")"
uv() { "$MISE" exec uv -- uv "$@"; }

# Consolidate: drop earlier pipx / ansible-core-only installs
if command -v pipx >/dev/null 2>&1 && pipx list --short 2>/dev/null | grep -q '^ansible '; then
    pipx uninstall ansible
fi
if uv tool list 2>/dev/null | grep -q '^ansible-core '; then
    uv tool uninstall ansible-core
fi
uv tool install --upgrade ansible --with-executables-from ansible-core

# usage-push every hour at :17
( crontab -l 2>/dev/null | grep -v '/usage-push' || true
  echo '17 * * * * $HOME/.local/bin/usage-push' ) | crontab -
{{ end -}}
